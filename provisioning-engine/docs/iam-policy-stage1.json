{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "ReadOnlyDiscovery",
			"Effect": "Allow",
			"Action": [
				"ec2:Describe*",
				"ec2:GetSecurityGroupsForVpc"
			],
			"Resource": "*",
			"Condition": {
				"StringEquals": {
					"aws:RequestedRegion": "ap-northeast-2"
				}
			}
		},
		{
			"Sid": "ReadAmiIdFromPublicSsmParameter",
			"Effect": "Allow",
			"Action": [
				"ssm:GetParameter",
				"ssm:GetParameters"
			],
			"Resource": [
				"arn:aws:ssm:ap-northeast-2::parameter/aws/service/canonical/*",
				"arn:aws:ssm:ap-northeast-2::parameter/aws/service/ami-amazon-linux-latest/*"
			]
		},
		{
			"Sid": "RunInstancesTypeRestricted",
			"Effect": "Allow",
			"Action": "ec2:RunInstances",
			"Resource": "arn:aws:ec2:ap-northeast-2:*:instance/*",
			"Condition": {
				"StringEquals": {
					"ec2:InstanceType": [
						"t3.micro",
						"t3.medium",
						"t3.large"
					]
				}
			}
		},
		{
			"Sid": "RunInstancesSupportingResources",
			"Effect": "Allow",
			"Action": "ec2:RunInstances",
			"Resource": [
				"arn:aws:ec2:ap-northeast-2:*:volume/*",
				"arn:aws:ec2:ap-northeast-2:*:network-interface/*",
				"arn:aws:ec2:ap-northeast-2:*:security-group/*",
				"arn:aws:ec2:ap-northeast-2:*:subnet/*",
				"arn:aws:ec2:ap-northeast-2:*:key-pair/*",
				"arn:aws:ec2:ap-northeast-2::image/*",
				"arn:aws:ec2:ap-northeast-2::snapshot/*"
			]
		},
		{
			"Sid": "ManageOnlyResourcesThisToolCreated",
			"Effect": "Allow",
			"Action": [
				"ec2:TerminateInstances",
				"ec2:StartInstances",
				"ec2:StopInstances",
				"ec2:ModifyInstanceAttribute"
			],
			"Resource": "arn:aws:ec2:ap-northeast-2:*:instance/*",
			"Condition": {
				"StringEquals": {
					"ec2:ResourceTag/ManagedBy": "mcp-provisioning"
				}
			}
		},
		{
			"Sid": "ManageSecurityGroups",
			"Effect": "Allow",
			"Action": [
				"ec2:CreateSecurityGroup",
				"ec2:DeleteSecurityGroup",
				"ec2:AuthorizeSecurityGroupIngress",
				"ec2:AuthorizeSecurityGroupEgress",
				"ec2:RevokeSecurityGroupIngress",
				"ec2:RevokeSecurityGroupEgress"
			],
			"Resource": [
				"arn:aws:ec2:ap-northeast-2:*:security-group/*",
				"arn:aws:ec2:ap-northeast-2:*:security-group-rule/*",
				"arn:aws:ec2:ap-northeast-2:*:vpc/*"
			]
		},
		{
			"Sid": "Tagging",
			"Effect": "Allow",
			"Action": [
				"ec2:CreateTags",
				"ec2:DeleteTags"
			],
			"Resource": "arn:aws:ec2:ap-northeast-2:*:*/*",
			"Condition": {
				"StringEquals": {
					"aws:RequestedRegion": "ap-northeast-2"
				}
			}
		},
		{
			"Sid": "DenyEverythingOutsideSeoul",
			"Effect": "Deny",
			"NotAction": [
				"iam:*",
				"sts:*"
			],
			"Resource": "*",
			"Condition": {
				"StringNotEquals": {
					"aws:RequestedRegion": "ap-northeast-2"
				}
			}
		}
	]
}
